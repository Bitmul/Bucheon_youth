	background-size: cover;
	background-position: center;
	position: relative;
}

.menu-slide {
	min-height: 480px;
	height: 60vh;
	background-size: cover;
	background-position: center;
	position: relative;
}

.slide-about {
	background-image: url('/images/banner-teamwork.webp');
}

.slide-roastery {
	background-image: url('/images/banner-roastery.webp');
}

.slide-lab {
	background-image: url('/images/banner-roast.webp');
}

.slide-stories {
	background-image: url('/images/banner-grow.webp');
}

.about-banner {
	background-image: url('/images/banner-about.webp');
}

.awards-banner {
	background-image: url('/images/banner-awards.webp');
}

.roastery-banner {
	background-image: url('/images/banner-roastery.webp');
}

.roasting-banner {
	background-image: url('/images/banner-roast.webp');
}

.about-banner,
.awards-banner,
.roasting-banner,
.roastery-banner {
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	position: relative;
	min-height: 360px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.awards-timeline {
	position: relative;
	padding-left: 2rem;
	border-left: 3px solid #e9ecef;
}

.awards-timeline-item {
	position: relative;
	margin-bottom: 2.5rem;
	display: flex;
	align-items: center;
	width: 100%;
}

.awards-timeline-item:last-child {
	margin-bottom: 0;
}

.awards-timeline::before {
	content: '';
	position: absolute;
	top: 0;
	bottom: 0;
	left: 1.25rem;
	/* 트로피 뱃지의 X축 중앙 고정 */
	width: 2px;
	background-color: #ffd700;
}

.awards-timeline-badge {
	position: absolute;
	left: -3.5rem;
	/* 확장된 padding-left에 맞춰 아이콘 위치 좌측 이동 */
	top: 50%;
	transform: translateY(-50%);
	width: 2.5rem;
	height: 2.5rem;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #fff;
	z-index: 2;
	box-shadow: 0 0 0 4px #fff;
}

.awards-timeline-item>.bg-white {
	width: 100%;
}
.hero-slide {
	height: 520px;
	background-size: cover;
	background-position: center;
	position: relative;
}

.menu-slide {
	min-height: 480px;
	height: 60vh;
	background-size: cover;
	background-position: center;
	position: relative;
}

.slide-about {
	background-image: url('/images/banner-teamwork.png');
}

.slide-roastery {
	background-image: url('/images/banner-cafe.png');
}

.slide-lab {
	background-image: url('/images/banner-roast.png');
}

.slide-stories {
	background-image: url('/images/banner-grow.png');
}

.slide-contact {
	background-image: url('/images/banner-road.png');
}

.about-banner {
	background-image: url('/images/banner-about.png');
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	position: relative;
}

.awards-banner {
	background-image: url('/images/banner-awards.png');
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	position: relative;
}

.roastery-banner {
	background-image: url('/images/banner-roastery.png');
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	position: relative;
}

.roasting-banner {
	background-image: url('/images/banner-roasting-lab.png');
}

.about-banner,
.awards-banner,
.roasting-banner,
.roastery-banner {
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	position: relative;
	min-height: 360px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.awards-timeline {
	position: relative;
	padding-left: 2rem;
	border-left: 3px solid #e9ecef;
}

.awards-timeline-item {
	position: relative;
	margin-bottom: 3rem;
}

.awards-timeline-item:last-child {
	margin-bottom: 0;
}

.awards-timeline-badge {
	position: absolute;
	left: -2.85rem;
	top: 0;
	width: 42px;
	height: 42px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-weight: bold;
	box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
}
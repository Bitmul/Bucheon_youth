.hero-overlay {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: linear-gradient(to right, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.25));
	z-index: 0;
}

.gradient-overlay {
	background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
}

.carousel-caption {
	bottom: 25%;
	z-index: 2;
}

.carousel-control-prev-icon,
.carousel-control-next-icon {
	width: 3.5rem;
	height: 3.5rem;
	background-color: rgba(0, 0, 0, 0.4);
	border-radius: 50%;
	background-size: 45%;
}

.carousel-control-prev-icon:hover,
.carousel-control-next-icon:hover {
	background-color: rgba(0, 0, 0, 0.7);
}

.quick-card {
	transition: transform 0.2s ease, box-shadow 0.2s ease;
	border: 1px solid #e2e8f0;
}

.quick-card:hover {
	transform: translateY(-5px);
	box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
}

.process-card,
.benefit-box {
	transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.process-card:hover,
.benefit-box:hover {
	transform: translateY(-5px);
	box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
}

.store-img-wrapper {
	position: relative;
	height: 220px;
	overflow: hidden;
}

.store-img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.3s ease;
}

.store-card {
	transition: transform 0.3s ease, box-shadow 0.3s ease;
	border-radius: 16px;
}

.store-card:hover {
	transform: translateY(-8px);
	box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12) !important;
}

.store-card:hover .store-img {
	transform: scale(1.08);
}

.story-img-wrapper {
	position: relative;
	height: 260px;
	overflow: hidden;
}

.story-img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.4s ease;
}

.story-card {
	transition: transform 0.3s ease, box-shadow 0.3s ease;
	border-radius: 20px;
}

.story-card:hover {
	transform: translateY(-8px);
	box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12) !important;
}

.story-card:hover .story-img {
	transform: scale(1.06);
}

.logo-item {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 10px;
}

.logo-img {
	max-height: 48px;
	width: auto;
	object-fit: contain;
	filter: grayscale(30%);
	transition: filter 0.3s ease, transform 0.3s ease;
	opacity: 0.85;
}

.logo-img:hover {
	filter: grayscale(0%);
	opacity: 1;
	transform: scale(1.05);
}

.logo-control {
	width: 30px;
}

.logo-control .carousel-control-prev-icon,
.logo-control .carousel-control-next-icon {
	width: 1.8rem;
	height: 1.8rem;
	background-color: rgba(0, 0, 0, 0.2);
	border-radius: 50%;
	background-size: 50%;
}

.logo-control .carousel-control-prev-icon:hover,
.logo-control .carousel-control-next-icon:hover {
	background-color: rgba(0, 0, 0, 0.5);
}

.step-badge {
	width: 38px;
	height: 38px;
	border-radius: 50%;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	font-size: 0.95rem;
	font-weight: 700;
	margin-bottom: 0.75rem;
}

.cta-box {
	max-width: 800px;
}